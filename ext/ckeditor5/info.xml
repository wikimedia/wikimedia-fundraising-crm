<?xml version="1.0"?>
<extension key="ckeditor5" type="module">
  <file>ckeditor5</file>
  <name>CKEditor5</name>
  <description>CKEditor 5 WYSIWYG integration for CiviCRM</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Jonathan Dahan</name>
      <email>jonathan@dhn.one</email>
      <role>Maintainer</role>
    </author>
    <author>
      <name>Eileen McNaughton</name>
      <email>emcnaughton@wikimedia.org</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://lab.civicrm.org/extensions/ckeditor5</url>
    <url desc="Documentation">https://lab.civicrm.org/extensions/ckeditor5</url>
    <url desc="Support">https://lab.civicrm.org/extensions/ckeditor5</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-11-03</releaseDate>
  <version>1.9.2</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.16</ver>
  </compatibility>
  <php_compatibility>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
    <ver>8.5</ver>
  </php_compatibility>
  <smarty_compatibility>
    <ver>5</ver>
  </smarty_compatibility>
  <comments>This presents CKEditor 5 as an option for the wysiwyg editor.</comments>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
  <civix>
    <namespace>CRM/Ckeditor5</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\Ckeditor5\AutomaticUpgrader</upgrader>
</extension>
